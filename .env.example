# Local Business Assistant Environment Variables
# Copy this file to .env.local and populate your secrets

# Primary & Secondary LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Provider Configuration
# Options: 'gemini' | 'groq' (defaults to 'gemini')
PRIMARY_PROVIDER=gemini

# Model Identifiers (Check availability with your provider account)
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_MODEL=qwen/qwen3.8-27b

# Owner Authentication (Required for /owner console)
OWNER_PASSWORD=your_secure_owner_password_here
SESSION_SECRET=your_random_secret_for_signing_session_cookies_here

# Supabase Postgres Configuration (Set USE_MEMORY_DB=true for local in-memory fallback)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
USE_MEMORY_DB=false

# Optional Telegram Channel Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_secret_string_for_webhook_validation
TELEGRAM_OWNER_CHAT_ID=your_telegram_chat_id_for_notifications

